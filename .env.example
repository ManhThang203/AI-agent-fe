# Backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Pusher / Soketi (optional — leave VITE_PUSHER_KEY empty to disable client realtime)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1
# Custom host (Soketi) — when set, cluster is cleared on client
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=6001
VITE_PUSHER_USE_TLS=true

# Must match AI-agent-api agentRealtime.js
VITE_AGENT_SOCKET_CHANNEL_PREFIX=agent-user
# "true" if backend AGENT_PUSHER_USE_PRIVATE_CHANNELS=true
VITE_AGENT_PUSHER_USE_PRIVATE_CHANNELS=false
