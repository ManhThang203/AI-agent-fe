# Backend API (Express) — no trailing slash
VITE_API_BASE_URL=http://localhost:8000

# Giống AGENT_SOCKET_CHANNEL_PREFIX trên BE (mặc định agent-user)
VITE_AGENT_CHANNEL_PREFIX=agent-user

# Pusher hoặc Soketi (trùng key/host với BE)
VITE_PUSHER_KEY=
# cluster bắt buộc với Pusher thương mại; Soketi có thể để mt1
VITE_PUSHER_CLUSTER=mt1
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
# true = wss — đặt false cho Soketi local HTTP nếu cần
VITE_PUSHER_TLS=true
